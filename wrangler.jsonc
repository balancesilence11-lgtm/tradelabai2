{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradelabai2",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tradelab-ai-db",
      "database_id": "a83ed9da-0af2-465c-9508-d2f18190826f"
    }
  ]
}
